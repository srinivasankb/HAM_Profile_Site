---
import Layout from '../layouts/Layout.astro';
import { Image as ImageIcon, ArrowLeft, X, ChevronLeft, ChevronRight, Calendar, FileText } from 'lucide-react';
import galleryData from '../data/gallery.json';

// Sort by date descending
const sortedGallery = [...galleryData].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="Photo Gallery | VU35KB" description="Explore the photo gallery of VU35KB: amateur radio station photos, QSL cards, and field day moments.">
  <div class="modern-container" style="max-width: 900px;">
    <!-- Page Header -->
    <section class="gallery-page-header">
      <a href="/" class="gallery-back-link" data-astro-prefetch>
        <ArrowLeft size={18} /> Back to Home
      </a>
      <h1 class="gallery-page-title">Photo Gallery</h1>
      <p class="gallery-page-desc">Moments from the shack, field days, and the amateur radio journey.</p>
    </section>

    <!-- Gallery Grid -->
    <section class="gallery-masonry" id="gallery-grid">
      {sortedGallery.map((item, index) => (
        <article
          class="gallery-card"
          data-index={index}
          data-filename={item.filename}
          data-title={item.title}
          data-description={item.description}
          data-date={item.date}
          role="button"
          tabindex="0"
          aria-label={`View photo: ${item.title}`}
        >
          <div class="gallery-card-img-wrap">
            <img
              src={`/gallery_images/${item.filename}`}
              alt={item.title}
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
              class="gallery-card-img"
            />
          </div>
          <div class="gallery-card-info">
            <h2 class="gallery-card-title">{item.title}</h2>
            <time class="gallery-card-date" datetime={item.date}>
              {new Date(item.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
        </article>
      ))}
    </section>

    {sortedGallery.length === 0 && (
      <div class="gallery-empty">
        <ImageIcon size={48} />
        <p>No photos yet. Check back soon!</p>
      </div>
    )}
  </div>

  <!-- Lightbox Modal -->
  <div class="lightbox-overlay" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close image viewer">
      <X size={24} />
    </button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous image">
      <ChevronLeft size={32} />
    </button>
    <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next image">
      <ChevronRight size={32} />
    </button>
    <div class="lightbox-content" id="lightbox-content">
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <div class="lightbox-details" id="lightbox-details">
        <h3 class="lightbox-title" id="lightbox-title"></h3>
        <time class="lightbox-date" id="lightbox-date"></time>
        <p class="lightbox-desc" id="lightbox-desc"></p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.gallery-card');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDate = document.getElementById('lightbox-date');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    if (!lightbox || !cards.length) return;

    let currentIndex = 0;
    let startX = 0;
    let startY = 0;

    function openLightbox(index) {
      currentIndex = index;
      const card = cards[index];
      const filename = card.dataset.filename;
      const title = card.dataset.title;
      const date = card.dataset.date;
      const desc = card.dataset.description;

      lightboxImg.src = `/gallery_images/${filename}`;
      lightboxImg.alt = title;
      lightboxTitle.textContent = title;
      lightboxDate.textContent = new Date(date).toLocaleDateString('en-IN', {
        year: 'numeric', month: 'long', day: 'numeric'
      });
      lightboxDesc.textContent = desc || '';
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';

      // Update nav button visibility
      prevBtn.style.display = currentIndex > 0 ? 'flex' : 'none';
      nextBtn.style.display = currentIndex < cards.length - 1 ? 'flex' : 'none';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }

    function navigate(direction) {
      const newIndex = currentIndex + direction;
      if (newIndex >= 0 && newIndex < cards.length) {
        openLightbox(newIndex);
      }
    }

    // Card click/tap
    cards.forEach((card, i) => {
      card.addEventListener('click', () => openLightbox(i));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(i);
        }
      });
    });

    // Close
    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Navigation
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); navigate(-1); });
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); navigate(1); });

    // Keyboard nav
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
    });

    // Touch/swipe support
    lightbox.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });

    lightbox.addEventListener('touchend', (e) => {
      const endX = e.changedTouches[0].clientX;
      const endY = e.changedTouches[0].clientY;
      const diffX = endX - startX;
      const diffY = endY - startY;

      // Only trigger swipe if horizontal movement > vertical
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
        if (diffX > 0) navigate(-1); // swipe right = prev
        else navigate(1);            // swipe left = next
      }
    }, { passive: true });
  });
</script>

<style>
  /* Page Header */
  .gallery-page-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .gallery-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }

  .gallery-back-link:hover {
    color: var(--primary);
  }

  .gallery-page-title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    color: var(--foreground);
  }

  .gallery-page-desc {
    color: var(--muted-foreground);
    font-size: 1.05rem;
  }

  /* Gallery Grid */
  .gallery-masonry {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .gallery-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
  }

  .gallery-card:hover,
  .gallery-card:focus-visible {
    border-color: #d4d4d8;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
    transform: translateY(-4px);
  }

  .gallery-card-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--secondary);
  }

  .gallery-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .gallery-card:hover .gallery-card-img {
    transform: scale(1.05);
  }

  .gallery-card-info {
    padding: 1rem 1.25rem;
  }

  .gallery-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 0.35rem;
    line-height: 1.4;
  }

  .gallery-card-date {
    font-size: 0.8rem;
    color: var(--muted-foreground);
    font-weight: 500;
  }

  /* Empty State */
  .gallery-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--muted-foreground);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* Lightbox */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .lightbox-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #fff;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 10001;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #fff;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 10001;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox-prev {
    left: 1rem;
  }

  .lightbox-next {
    right: 1rem;
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    pointer-events: none;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    pointer-events: auto;
  }

  .lightbox-details {
    text-align: center;
    color: #fff;
    max-width: 600px;
    pointer-events: auto;
  }

  .lightbox-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .lightbox-date {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    display: block;
    margin-bottom: 0.5rem;
  }

  .lightbox-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .gallery-page-title {
      font-size: 2rem;
    }

    .gallery-masonry {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1rem;
    }

    .lightbox-nav {
      width: 40px;
      height: 40px;
    }

    .lightbox-prev {
      left: 0.5rem;
    }

    .lightbox-next {
      right: 0.5rem;
    }

    .lightbox-img {
      max-height: 60vh;
    }
  }

  @media (max-width: 480px) {
    .gallery-masonry {
      grid-template-columns: 1fr;
    }
  }
</style>
