---
import Layout from '../layouts/Layout.astro';
import IndiaBandPlan from '../components/IndiaBandPlan';

const title = 'India Amateur Radio Band Plan | VU35KB';
const description = 'Interactive modern India amateur radio band plan (NFAP) with visual spectrum scale, live search, mode filters, General vs Restricted grade comparison, and beautiful printable shack charts.';
const siteUrl = 'https://ham.srinikb.in';
---

<Layout {title} {description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "India HAM Radio Band Plan",
    "description": description,
    "url": `${siteUrl}/india-band-plan`,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "INR"
    },
    "author": {
      "@type": "Person",
      "name": "Srinivasan KB",
      "alternateName": "VU35KB"
    },
    "about": {
      "@type": "Thing",
      "name": "Amateur Radio Frequency Allocations in India",
      "description": "National Frequency Allocation Plan (NFAP-2025) band allocations for Indian amateur radio operators"
    },
    "featureList": [
      "Modern interactive MF/HF/VHF/UHF/SHF spectrum visual scale",
      "Restricted and General grade privilege comparison with diff views",
      "Live frequency search with smart unit conversion (MHz, kHz, GHz)",
      "Filter by Voice, CW, and Digital modes",
      "Detailed band cards with sub-band segments and IARU notes",
      "National Frequency Allocation Plan (NFAP) regulatory reference",
      "Beautiful printable shack charts with layout options"
    ]
  })} />
  <IndiaBandPlan client:only="react" />
</Layout>
