---
import Layout from '../layouts/Layout.astro';
import IndiaBandPlan from '../components/IndiaBandPlan';

const title = 'India Band Plan | VU35KB';
const description = 'Interactive India amateur radio band plan (NFAP-2025) with WPC allocations, allocation status, sub-bands, mode filters, grade comparison, and printable shack charts for Restricted and General grade licenses.';
const siteUrl = 'https://ham.srinikb.in';
---

<Layout {title} {description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "India HAM Radio Band Plan",
    "description": description,
    "url": `${siteUrl}/india-band-plan`,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "INR"
    },
    "author": {
      "@type": "Person",
      "name": "Srinivasan KB",
      "alternateName": "VU35KB"
    },
    "about": {
      "@type": "Thing",
      "name": "Amateur Radio Frequency Allocations in India",
      "description": "National Frequency Allocation Plan (NFAP-2025) band allocations for Indian amateur radio operators"
    },
    "featureList": [
      "Interactive MF/HF/VHF/UHF/SHF spectrum map",
      "Restricted and General grade comparison",
      "Filter by Voice, CW, and Digital modes",
      "Allocation status badges and sub-band segments",
      "NFAP-2025 regulatory reference",
      "Printable shack chart with QR code and layout options"
    ]
  })} />
  <IndiaBandPlan client:only="react" />
</Layout>
