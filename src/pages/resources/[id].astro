---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { 
  ChevronLeft,
  ExternalLink,
  BookOpen
} from 'lucide-react';
import '../../styles/resource-prose.css';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map(resource => ({
    params: { id: resource.id },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);

const categories = {
  operating: { label: 'Operating' },
  technical: { label: 'Technical' },
  software: { label: 'Software' },
  learning: { label: 'Learning' },
  tools: { label: 'Tools' },
};

const categoryLabel = categories[resource.data.category as keyof typeof categories]?.label || resource.data.category;
---

<Layout title={`${resource.data.title} | Resource Library`} description={resource.data.description}>
  <div class="resource-layout resource-article">
    <nav class="resource-breadcrumb">
      <a href="/resources" class="resource-back-link">
        <ChevronLeft size={16} /> Back to Library
      </a>
    </nav>

    <header class="resource-article-header">
      <div class="resource-article-meta">
        <span class={`resource-category-tag ${resource.data.category}`}>
          {categoryLabel}
        </span>
        {resource.data.pinned && <span class="resource-pinned-label">Essential</span>}
      </div>
      
      <h1 class="resource-article-title">{resource.data.title}</h1>
      <p class="resource-article-description">{resource.data.description}</p>

      {resource.data.url && (
        <div class="resource-external-box">
          <p>This resource is also available at an external location:</p>
          <a href={resource.data.url} target="_blank" rel="noopener noreferrer" class="resource-external-action">
            Visit Source Website <ExternalLink size={16} />
          </a>
        </div>
      )}
    </header>

    <hr class="resource-header-divider" />

    <article class="prose resource-prose">
      <Content />
    </article>

    <footer class="resource-article-footer">
      <div class="resource-footer-note">
        <BookOpen size={16} /> Part of the VU35KB Knowledge Base
      </div>
    </footer>
  </div>
</Layout>
